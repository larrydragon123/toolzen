---
interface Props { section?: 'blog' }
const { section } = Astro.props;
const suffix = section ? '/blog/' : '/';
const en = '/en' + suffix;
const zh = '/zh' + suffix;
const title = section ? 'ToolZen Blog' : 'ToolZen';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="UOFVIgZElQad5DB9kHrqqSFbjqNrabmSC2E6LGe8Hu8" />
  <meta name="baidu-site-verification" content="codeva-F9IAWHNg1F" />
  <title>{title} | English · 中文</title>
  <link rel="canonical" href={new URL(suffix, Astro.site).href} />
  <link rel="alternate" hreflang="en" href={new URL(en, Astro.site).href} />
  <link rel="alternate" hreflang="zh" href={new URL(zh, Astro.site).href} />
  <link rel="alternate" hreflang="x-default" href={new URL(suffix, Astro.site).href} />
</head>
<body>
  <main>
    <h1>{title}</h1>
    <nav aria-label="Choose your language">
      <a href={en} lang="en" hreflang="en">English</a> ·
      <a href={zh} lang="zh-CN" hreflang="zh">中文版</a>
    </nav>
  </main>
  <script define:vars={{ en, zh }}>
    const preferred = document.cookie.split('; ').find(item => item.startsWith('lang='))?.slice(5);
    const language = preferred === 'en' || preferred === 'zh' ? preferred : navigator.language;
    window.location.replace((language.startsWith('zh') ? zh : en) + location.search + location.hash);
  </script>
</body>
</html>
